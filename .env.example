# ── Discord ──────────────────────────────────────────────
# Paste your bot token and channel ID here (see README for how to get these)
DISCORD_BOT_TOKEN=your-bot-token-here
DISCORD_CHANNEL_ID=123456789012345678

# Optional: a Discord role ID to ping on corruption alerts (instead of @here).
# Right-click a role in Server Settings > Roles, then "Copy Role ID".
# Leave blank to use @here instead.
ALERT_ROLE_ID=

# ── Detection settings (you can leave these as-is) ──────
# How often to check (in minutes). 15-30 is fine since Nitrado saves hourly.
CHECK_INTERVAL_MINUTES=15

# How big of a size drop triggers an alert.
# 30 means "alert me if the save file shrinks by more than 30%".
DROP_THRESHOLD_PERCENT=30

# How many past save sizes to remember.
# 10 with hourly saves = roughly 10 hours of history.
HISTORY_DEPTH=10

# ── Your servers ────────────────────────────────────────
# Your server list goes in servers.json (not here).
# Copy servers.example.json to servers.json and fill in your details.
